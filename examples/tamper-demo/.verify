# Inside the project, so the agent can edit it — which is the point of the demo.
# A real run keeps this outside the project and passes it with --sealed-verify.
verify_command=python3 run_backtest.py

# This demo is about tampering, not held-out data. Empty opts out of the mode's
# hidden command, so nothing meaningless lands in hidden_metrics.json.
hidden_verify_command=
